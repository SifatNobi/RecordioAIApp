# RevenueCat Configuration
# Get your Android public SDK key from RevenueCat dashboard
# https://app.revenuecat.com/
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# API Configuration
# Backend origin. The app appends "/api" itself because the FastAPI service
# mounts its router at that prefix (see backend/server.py). Point this at the
# deployed host, e.g. https://recordioai-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=https://recordioaiapp.onrender.com

# Environment
# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# AI Agent Provider Configuration (optional)
# These are placeholder examples - configure based on your integrations
# EXPO_PUBLIC_RETELL_API_KEY=
# EXPO_PUBLIC_VAPI_API_KEY=
# EXPO_PUBLIC_BLAND_API_KEY=

# Feature Flags
# EXPO_PUBLIC_ENABLE_TEST_MODE=false