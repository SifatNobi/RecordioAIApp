{
  "expo": {
    "name": "RecordioAIApp",
    "slug": "recordioai",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#000000",
    "scheme": "recordioai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recordioai.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSMicrophoneUsageDescription": "RecordioAI uses the microphone to capture conversation audio for transcription and AI analysis."
      }
    },
    "android": {
      "package": "com.recordioai.app",
      "versionCode": 4,
      "version": "1.1.1",
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "style": "light",
          "enforceContrast": true
        }
      ],
      ["expo-status-bar", { "style": "light" }],
      "expo-secure-store",
      "expo-font",
      "./plugins/withRecordioRecording",
      "./plugins/withRecordioTestBundle",
      "./plugins/withRecordioInstallableApk",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.1.20",
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "owner": "kazinobi",
    "extra": {
      "eas": {
        "projectId": "c99489ca-d611-4810-88ef-2a97477f7af4"
      }
    }
  }
}
